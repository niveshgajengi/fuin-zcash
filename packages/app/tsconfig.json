{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@deployments/*": [
        "../../deployments/*"
      ],
      "@sba/circuits/result": [
        "../circuits/src/result.ts"
      ],
      "@sba/circuits/poseidon": [
        "../circuits/src/poseidon.ts"
      ]
    }
  },
  "include": [
    "src",
    "../circuits/src/modules.d.ts"
  ]
}
