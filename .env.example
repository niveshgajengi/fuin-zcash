# Names only; put real values in a gitignored .env. Never commit keys.
# zingo-cli binary and lightwalletd (defaults: ~/src/zingolib/target/release/zingo-cli, testnet.zec.rocks)
SBA_ZINGO_CLI=
SBA_LWD_URL=
# sba-verify binary (default packages/verifier/target/release/sba-verify)
SBA_VERIFY_BIN=
# viewing keys for sba-verify (tx / derive) and the audit script
SBA_UIVK=
SBA_UFVK=
# optional: the seller's incoming viewing key, so the audit checks the seller's payout
SBA_SELLER_UIVK=
SBA_AUDIT_UIVK=
# MCP bidder: the auction card, the bidder's zingo wallet and reveal folder
SBA_AUCTION_FILE=
SBA_BIDDER_WALLET=
SBA_BIDDER_DIR=
# optional: a refunds-only wallet whose incoming viewing key `complain({ include_refund_key: true })` publishes
SBA_REFUND_WALLET=
# e2e: the port e2e/stack.sh serves the site on (default 4180), or another copy of the site
FUIN_PORT=
FUIN_LANDING=
FUIN_SALEROOM=
